// The GPU backend of the UI framework: turns the drawing commands of a laid out tree into a metal scene, measures text with the
// glyph atlas and keeps the fonts and icons. The framework (../ui) works in points; everything here multiplies by the scale of the
// screen (2 on a Retina display) to get device pixels.
package render

import "../ui"
import "glyph"
import "metal"

// Font numbers: the tree's text nodes use these.
const FontUI = 0
const FontUIBold = 1
const FontSmall = 2
const FontCode = 3

// Icon numbers, in the order Init registers them.
const IconFolder = 0
const IconFolderOpen = 1
const IconFile = 2
const IconCode = 3
const IconChevronRight = 4
const IconChevronDown = 5
const IconPanel = 6
const IconGit = 7
const IconOutline = 8
const IconSearch = 9
const IconWarning = 10
const IconTerminal = 11
const IconDebug = 12
const IconClose = 13
const IconPlus = 14
const IconGear = 15
const IconText = 16
const IconImage = 17
const IconRefresh = 18

// Canvas is the GPU, the glyph atlas and the screen scale.
type Canvas struct {
	Gpu metal.Gpu
	Atlas metal.Atlas
	Scale f64
	Code f64
}

// The font names Init uses (PostScript names): the interface font and the code font; UseFonts changes them for the next Init.
mut uiFont = ".AppleSystemUIFont"
mut uiBold = ".AppleSystemUIFont-Bold"
mut codeFont = "Menlo-Regular"

// UseFonts chooses the fonts (empty keeps the current one); call it before Init.
fn UseFonts(ui str, code str) {
	if len(ui) > 0 {
		uiFont = keep(ui)
		uiBold = keep(ui + "-Bold")
	}
	if len(code) > 0 {
		codeFont = keep(code)
	}
}

mut cv = Canvas{Gpu: metal.Gpu{}, Atlas: metal.EmptyAtlas(), Scale: 1.0}

// Init prepares the canvas for a screen scale: the fonts (a UI font and a monospaced one, with the code font size in points) and
// the icons. Call it once the GPU is open, and again if the window moves to a screen of another scale.
fn Init(gpu metal.Gpu, scale f64, codePoints f64) {
	cv = keep(Canvas{Gpu: gpu, Atlas: metal.NewAtlas(gpu, 2048), Scale: scale, Code: codePoints})
	cv.Atlas.AddFont(uiFont, 13.0 * scale)
	cv.Atlas.AddFont(uiBold, 13.0 * scale)
	cv.Atlas.AddFont(uiFont, 11.0 * scale)
	cv.Atlas.AddFont(codeFont, codePoints * scale)
	for name in []str{"folder", "folder.fill", "doc", "chevron.left.forwardslash.chevron.right", "chevron.right", "chevron.down", "sidebar.left", "arrow.triangle.branch", "list.bullet.indent", "magnifyingglass", "exclamationmark.triangle", "terminal", "ladybug", "xmark", "plus", "gearshape", "doc.text", "photo", "arrow.clockwise"} {
		cv.Atlas.AddIcon(name)
	}
}

// Scale is the scale Init was given.
fn Scale() f64 {
	return cv.Scale
}

// Width is how wide the text is in the font, in points: the sum of its characters' advances.
fn Width(font i64, text str) f64 {
	let f = cv.Atlas.Fonts[font]
	if font == FontCode {
		// a monospaced font: every character is one cell wide
		return f64(glyph.RuneCount(text)) * f.Advance / cv.Scale
	}
	mut w = 0.0
	mut i = 0
	for i < len(text) {
		let (r, n) = glyph.DecodeRune(text, i)
		i += n
		w += cv.Atlas.Lookup(font, r).Advance
	}
	return w / cv.Scale
}

// LineHeight is the height of a line of the font, in points.
fn LineHeight(font i64) f64 {
	if font >= len(cv.Atlas.Fonts) {
		// no GPU was opened (a test): a plausible line
		return 16.0
	}
	let f = cv.Atlas.Fonts[font]
	return f.Line / cv.Scale
}

// CodeCell is the width of one character of the code font, in points.
fn CodeCell() f64 {
	if len(cv.Atlas.Fonts) <= FontCode {
		return 7.8
	}
	return cv.Atlas.Fonts[FontCode].Advance / cv.Scale
}

// Pen draws the text in the font at (x, y), where y is the top of its line (points), and returns where the pen ended.
fn Pen(scene mut metal.Scene, font i64, x f64, y f64, text str, c i64) f64 {
	let f = cv.Atlas.Fonts[font]
	let s = cv.Scale
	mut cell = 0.0
	if font == FontCode {
		cell = f.Advance
	}
	let end = cv.Atlas.Text(mut scene, font, x * s, y * s + f.Ascent, text, cell, c)
	return end / s
}

// Draw paints the commands into the scene. A custom area is handed to custom with its id and rectangle (points) to paint
// itself; commands that clip are applied to everything after them until the matching unclip.
fn Draw(cmds []ui.Cmd, texts []str, scene mut metal.Scene, custom fn(i64, f64, f64, f64, f64, mut metal.Scene)) {
	let s = cv.Scale
	for c in cmds {
		if c.Kind == ui.CmdRect {
			scene.Rect(c.X * s, c.Y * s, c.W * s, c.H * s, c.Col, c.Radius * s)
		} else if c.Kind == ui.CmdBorder {
			scene.Outline(c.X * s, c.Y * s, c.W * s, c.H * s, c.Col, c.Radius * s, c.Border * s)
		} else if c.Kind == ui.CmdText {
			let f = cv.Atlas.Fonts[c.Font]
			let top = c.Y + (c.H - f.Line / s) / 2.0
			Pen(mut scene, c.Font, c.X, top, texts[c.Arg], c.Col)
		} else if c.Kind == ui.CmdIcon {
			let px = i64(c.W * s + 0.5)
			let g = cv.Atlas.Icon(c.Arg, px)
			scene.Sprite(f64(i64(c.X * s + 0.5)) - 1.0, f64(i64(c.Y * s + 0.5)) - 1.0, f64(g.W), f64(g.H), f64(g.X), f64(g.Y), c.Col)
		} else if c.Kind == ui.CmdClip {
			scene.PushClip(c.X * s, c.Y * s, c.W * s, c.H * s)
		} else if c.Kind == ui.CmdUnclip {
			scene.PopClip()
		} else if c.Kind == ui.CmdCustom {
			custom(c.Arg, c.X, c.Y, c.W, c.H, mut scene)
		}
	}
}

// Upload sends the glyphs drawn since the last frame to the GPU.
fn Upload() {
	cv.Atlas.Upload()
}

// Present draws the scene into the layer, w by h pixels, over the color.
fn Present(layer i64, w i64, h i64, scene metal.Scene, bg i64) {
	metal.DrawLayer(cv.Gpu, layer, w, h, scene, cv.Atlas, ui.R(bg), ui.G(bg), ui.B(bg), ui.A(bg))
}

// Fill paints a solid rectangle (points).
fn Fill(scene mut metal.Scene, x f64, y f64, w f64, h f64, c i64) {
	let s = cv.Scale
	scene.Rect(x * s, y * s, w * s, h * s, c, 0.0)
}

// FillRound paints a rectangle with rounded corners.
fn FillRound(scene mut metal.Scene, x f64, y f64, w f64, h f64, radius f64, c i64) {
	let s = cv.Scale
	scene.Rect(x * s, y * s, w * s, h * s, c, radius * s)
}

// Stroke paints the edge of a rectangle, width points wide, inside it.
fn Stroke(scene mut metal.Scene, x f64, y f64, w f64, h f64, radius f64, width f64, c i64) {
	let s = cv.Scale
	scene.Outline(x * s, y * s, w * s, h * s, c, radius * s, width * s)
}

// Clip limits what is drawn next to a rectangle (points) until Unclip.
fn Clip(scene mut metal.Scene, x f64, y f64, w f64, h f64) {
	let s = cv.Scale
	scene.PushClip(x * s, y * s, w * s, h * s)
}

fn Unclip(scene mut metal.Scene) {
	scene.PopClip()
}

// Hairline is the thickness of a one pixel line, in points.
fn Hairline() f64 {
	return 1.0 / cv.Scale
}

// Snapshot draws the scene over the color into an offscreen texture of w by h pixels and writes it as a PNG (tests and
// screenshots); it reports whether the file was written.
fn Snapshot(scene metal.Scene, w i64, h i64, bg i64, path str) bool {
	let t = metal.NewTarget(cv.Gpu, w, h)
	metal.Draw(cv.Gpu, t.Texture, w, h, scene, cv.Atlas, ui.R(bg), ui.G(bg), ui.B(bg), ui.A(bg))
	return metal.SavePNG(t, path)
}

// HaveGPU reports whether Init found a GPU.
fn HaveGPU() bool {
	return cv.Gpu.Device != 0
}

// SetCodeSize changes the size of the code font (points) and rebuilds the atlas for it.
fn SetCodeSize(points f64) {
	Init(cv.Gpu, cv.Scale, points)
}
