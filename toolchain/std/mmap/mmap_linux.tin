package mmap

// Linux side of mmap.tin: the mapping calls are runtime leaves; msync is a raw system call
// (number in mmap_linux_<cpu>.tin).

const mapShared = 1
const mapPrivate = 2
const mapAnonymous = 0x20
const mapPopulate = 0x8000
const msAsync = 1
const msSync = 4
const madvHugePage = 14

fn sysMap(addr i64, n i64, prot i64, flags i64, fd i64, off i64) i64 {
	return rt_sys_mmap(addr, n, prot, flags, fd, off)
}

fn sysUnmap(addr i64, n i64) i64 {
	return rt_sys_munmap(addr, n)
}

fn sysProtect(addr i64, n i64, prot i64) i64 {
	return rt_sys_mprotect(addr, n, prot)
}

fn sysAdvise(addr i64, n i64, advice i64) i64 {
	return rt_sys_madvise(addr, n, advice)
}

fn sysMsync(addr i64, n i64, flags i64) i64 {
	return linux_result(linux_raw(nrMsync, addr, n, flags, 0, 0, 0))
}

fn sysHugePage(addr i64, n i64) i64 {
	return rt_sys_madvise(addr, n, madvHugePage)
}
