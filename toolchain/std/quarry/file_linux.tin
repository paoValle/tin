package quarry

// Linux side of file.tin: raw system calls (numbers and open flags in file_linux_<cpu>.tin).

// Open flags shared by both Linux CPUs (asm-generic fcntl.h); oDirect, oDirectory and oNoFollow
// differ per CPU and live in the arch files. file.tin re-exports each as its public O* name.
const OReadOnly = 0
const OWriteOnly = 1
const OReadWrite = 2
const OCreate = 64       // 0x40
const OTruncate = 512    // 0x200
const OAppend = 1024     // 0x400
const OExcl = 128        // 0x80
const OSync = 1052672    // 0x101000
const ODsync = 4096      // 0x1000

const fGetFl = 3
const fSetFl = 4
const eOpNotSupp = 95
const eNoSys = 38

fn sysPwrite(fd i64, buf i64, n i64, off i64) i64 {
	return linux_result(linux_raw(nrPwrite64, fd, buf, n, off, 0, 0))
}

// preadv/pwritev take the offset split into its low and high 32-bit halves (sys_preadv's pos_l,
// pos_h), not as one register.
fn sysPreadV(fd i64, iov i64, cnt i64, off i64) i64 {
	return linux_result(linux_raw(nrPreadv, fd, iov, cnt, off, off >> 32, 0))
}

fn sysPwriteV(fd i64, iov i64, cnt i64, off i64) i64 {
	return linux_result(linux_raw(nrPwritev, fd, iov, cnt, off, off >> 32, 0))
}

fn sysFtruncate(fd i64, n i64) i64 {
	return linux_result(linux_raw(nrFtruncate, fd, n, 0, 0, 0, 0))
}

// sysFallocate returns 0 or the error code: EOPNOTSUPP when the file system has no fallocate.
fn sysFallocate(fd i64, off i64, n i64) i64 {
	if linux_result(linux_raw(nrFallocate, fd, 0, off, n, 0, 0)) == 0 {
		return 0
	}
	return errno()
}

fn sysFdatasync(fd i64) i64 {
	return linux_result(linux_raw(nrFdatasync, fd, 0, 0, 0, 0, 0))
}

// sysReadAhead returns 0 or the error code.
fn sysReadAhead(fd i64, off i64, n i64) i64 {
	if linux_result(linux_raw(nrReadahead, fd, off, n, 0, 0, 0)) == 0 {
		return 0
	}
	return errno()
}

// sysFadvise is best-effort: a kernel or file system that refuses the hint does nothing.
fn sysFadvise(fd i64, off i64, n i64, advice i64) {
	linux_result(linux_raw(nrFadvise64, fd, off, n, advice, 0, 0))
}

// sysSyncRange returns 0 or the error code.
fn sysSyncRange(fd i64, off i64, n i64, flags i64) i64 {
	if linux_result(linux_raw(nrSyncFileRange, fd, off, n, flags, 0, 0)) == 0 {
		return 0
	}
	return errno()
}

fn sysFlock(fd i64, op i64) i64 {
	return linux_result(linux_raw(nrFlock, fd, op, 0, 0, 0, 0))
}

// sysSetNoCache toggles O_DIRECT on the descriptor with fcntl(F_SETFL): 0 or the error code.
fn sysSetNoCache(fd i64, on bool) i64 {
	let flags = c32(rt_sys_fcntl(fd, fGetFl, 0))
	if flags < 0 {
		return errno()
	}
	mut want = flags & (ODirect ^ -1)
	if on {
		want = flags | ODirect
	}
	if c32(rt_sys_fcntl(fd, fSetFl, want)) != 0 {
		return errno()
	}
	return 0
}
