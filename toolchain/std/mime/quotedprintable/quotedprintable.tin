package quotedprintable

// Package quotedprintable encodes and decodes the quoted-printable transfer encoding of RFC
// 2045, as Go's mime/quotedprintable does: most bytes are themselves, "=" is written as "=3D",
// other bytes outside the printable range as "=XX" with uppercase hex, and a line longer than 76
// bytes is broken with a soft line break (a "=" at the end of the line).
//
//	let body = quotedprintable.Decode(part)      // "caf=C3=A9" -> "café"
//	let wire = quotedprintable.Encode("café")    // "caf=C3=A9"
//
// The decoder follows Go's deviations from the RFC: "=\\n" is a soft break as well as "=\\r\\n",
// a "\\r" or "\\n" not preceded by "=" passes through, a "=" at the end of the message is ignored,
// a "=" not followed by two hex digits is taken literally, trailing whitespace of a line is
// dropped, and a byte below 0x20 (or above 0x7e) that is not escaped is an error.
//
// The one-shot form covers the bodies MIME carries; a streaming reader and writer for very large
// bodies are the follow-up noted in #735.

import "say"
import "twine"

// lineMax is the longest line the encoder makes, Go's 76.
const lineMax = 76

// Decode returns the decoded bytes of a quoted-printable text, as Go's Reader reads them, with its
// faults: a bad byte in a line is reported where it is, and a bad soft break after the rest of its
// line is decoded.
fn Decode(s str) !str {
	mut out = []u8{}
	mut pos = i64(0)
	mut done = false
	for !done {
		// One line, with its line ending when it has one.
		mut nl = twine.IndexByte(s[pos:len(s)], '\n')
		mut whole = ""
		if nl < 0 {
			whole = s[pos:len(s)]
			pos = len(s)
			done = true
		} else {
			whole = s[pos:pos+nl+1]
			pos += nl + 1
		}
		// The line without its trailing whitespace.
		mut e = i64(len(whole))
		for e > 0 && (whole[e-1] == '\r' || whole[e-1] == '\n' || whole[e-1] == ' ' || whole[e-1] == '\t') {
			e -= 1
		}
		mut line = whole[0:e]
		// A bad soft break is reported once the line before it is decoded, as Go's reader does.
		mut softErr = ""
		if len(line) > 0 && line[len(line)-1] == '=' {
			// A soft break: only whitespace and the line ending may follow the "=".
			let rest = trimLeftWs(whole[len(line):len(whole)])
			line = line[0:len(line)-1]
			// A soft break may be followed by the line ending, or be the last line of the input
			// when something precedes the "=" (Go's rule exactly).
			if !(twine.HasPrefix(rest, "\n") || twine.HasPrefix(rest, "\r\n") ||
					(len(rest) == 0 && len(line) > 0 && done)) {
				softErr = say.Fmt("quotedprintable: invalid bytes after =: %q", rest)
			}
		} else if twine.HasSuffix(whole, "\r\n") {
			line += "\r\n"
		} else if twine.HasSuffix(whole, "\n") {
			line += "\n"
		}
		// The line's bytes.
		mut i = i64(0)
		for i < len(line) {
			let b = line[i]
			if b == '=' {
				mut hi = i64(-1)
				mut lo = i64(-1)
				if i+2 < len(line) {
					hi = hexVal(line[i+1])
					lo = hexVal(line[i+2])
				}
				if hi >= 0 && lo >= 0 {
					out = append(out, u8(hi*16+lo))
					i += 3
					continue
				}
				if i+1 < len(line) && line[i+1] != '\r' && line[i+1] != '\n' {
					// A "=" not followed by two hex digits is a literal "=".
					out = append(out, '=')
					i += 1
					continue
				}
				if i+2 >= len(line) {
					fail say.Fault("unexpected EOF")
				}
				fail say.Fault("quotedprintable: invalid hex byte 0x%02x", i64(line[i+1]))
			}
			if b == '\t' || b == '\r' || b == '\n' || b >= 0x80 {
				out = append(out, b)
				i += 1
				continue
			}
			if b < ' ' || b > '~' {
				fail say.Fault("quotedprintable: invalid unescaped byte 0x%02x in body", i64(b))
			}
			out = append(out, b)
			i += 1
		}
		if softErr != "" {
			fail say.Fault("%s", softErr)
		}
	}
	return str(out)
}

// Encode returns data as a quoted-printable text, as Go's Writer writes it: lines of at most 76
// bytes with soft breaks, "=" and the bytes outside printable ASCII escaped, line ends written as
// CRLF, and a space or tab at the end of a line escaped (with a soft break first when the escape
// does not fit).
fn Encode(data str) str {
	mut e = encoder{out: []u8{}, col: 0}
	mut cr = false
	for i in 0..len(data) {
		let b = data[i]
		if b == '\n' || b == '\r' {
			// The LF of a CRLF pair is already written.
			if cr && b == '\n' {
				cr = false
				continue
			}
			if b == '\r' {
				cr = true
			}
			e.escapeLastSpace()
			e.out = append(e.out, '\r', '\n')
			e.col = 0
		} else if b == '=' || (b < '!' || b > '~') && b != ' ' && b != '\t' {
			// Go's escape does not touch the pending CR.
			e.escape(b)
		} else {
			if e.col == lineMax-1 {
				e.softBreak()
			}
			e.out = append(e.out, b)
			e.col += 1
			cr = false
		}
	}
	e.escapeLastSpace()
	return str(e.out)
}

// encoder is Encode's output and the length of its current line.
type encoder struct {
	out []u8
	col i64
}

// softBreak ends the line with "=" and CRLF.
fn (e mut encoder) softBreak() {
	e.out = append(e.out, '=', '\r', '\n')
	e.col = 0
}

// escape writes b as =XX, after a soft break when the line has no room for it.
fn (e mut encoder) escape(b u8) {
	if lineMax-1-e.col < 3 {
		e.softBreak()
	}
	let hex = "0123456789ABCDEF"
	e.out = append(e.out, '=', hex[i64(b>>4)], hex[i64(b&15)])
	e.col += 3
}

// escapeLastSpace escapes a space or tab that ends the line, as Go's checkLastByte does.
fn (e mut encoder) escapeLastSpace() {
	if e.col == 0 {
		return
	}
	let last = e.out[len(e.out)-1]
	if last == ' ' || last == '\t' {
		e.out = e.out[0:len(e.out)-1]
		e.col -= 1
		e.escape(last)
	}
}

// trimLeftWs trims leading whitespace.
fn trimLeftWs(s str) str {
	mut a = i64(0)
	for a < len(s) && (s[a] == ' ' || s[a] == '\t') {
		a += 1
	}
	return s[a:len(s)]
}

// hexVal is a hex digit's value, or -1.
fn hexVal(c u8) i64 {
	if c >= '0' && c <= '9' {
		return i64(c - '0')
	}
	if c >= 'a' && c <= 'f' {
		return i64(c-'a') + 10
	}
	if c >= 'A' && c <= 'F' {
		return i64(c-'A') + 10
	}
	return -1
}
