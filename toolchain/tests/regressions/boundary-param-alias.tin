package main

// #1052: the same calls with mut parameters compile in limit, within and guard blocks and
// change the caller's struct.

import "constraints"
import "say"

type S struct {
	n i64
	m map[str]str
}

type B struct {
	s  str
	at i64
}

fn handle[R constraints.Any](s mut S, body mut R, x str) i64 {
	s.n += len(x)
	return s.n
}

fn bounded(srv mut S, body mut B, x str) i64 {
	mut server = srv
	mut b = body
	let (r, over) = limit memory 32mb {
		handle(mut server, mut b, x)
	}
	if over != nil {
		return -1
	}
	return r
}

fn timed(srv mut S, body mut B, x str) i64 {
	mut server = srv
	mut b = body
	let (r, over) = within 1s {
		handle(mut server, mut b, x)
	}
	if over != nil {
		return -1
	}
	return r
}

fn guarded(srv mut S, body mut B, x str) i64 {
	mut server = srv
	mut b = body
	let (r, over) = guard {
		handle(mut server, mut b, x)
	}
	if over != nil {
		return -1
	}
	return r
}

fn main() {
	mut s = S{n: 0, m: map[str]str{}}
	mut b = B{s: "abc", at: 0}
	say.Line(bounded(mut s, mut b, "xy"))
	say.Line(timed(mut s, mut b, "xyz"))
	say.Line(guarded(mut s, mut b, "w"))
	say.Line(s.n)
}
