package main

import "say"

// 5,000 per-core globals plus a dyn and an f64 one, past the 32,760 bytes a scaled imm12 of
// ldr/str reaches from x28 (#602). Generated once by a script; the expected output follows
// from the literals. g4063 sits exactly at that limit and g4064 just past it, so the emitted
// `ldr x21, [x28, #32760]` and `add x16, x28, #8, lsl #12` both run, next to the far
// increment, the far dyn store and the read inside a task: a threshold that lets an offset
// past 32,760 reach encode fails the link instead of truncating.

shape Namer {
	Value() i64
}

type Cat struct {
	lives i64
}

fn (c Cat) Value() i64 {
	return c.lives
}

