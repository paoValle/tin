package main

import "say"
import "stamp"

fn main() {
	let ins = []str{"", "a", "abc", "123456789", "The quick brown fox jumps over the lazy dog", "0123456789abcdef0123456789abcdef0123456789", say.Fmt("%0200d", 7)}
	for _, s in ins {
		say.Out("%d crc32=%08x crc32c=%08x fnv32a=%08x fnv64a=%016x adler=%08x xxh64=%016x xxh64s=%016x\n", len(s), stamp.Crc32(s), stamp.Crc32C(s), stamp.Fnv32a(s), stamp.Fnv64a(s), stamp.Adler32(s), stamp.Xxh64(s, 0), stamp.Xxh64(s, 2654435761))
	}
	say.Out("update %08x %08x %08x\n", stamp.Crc32Update(stamp.Crc32("hello "), "world"), stamp.Crc32("hello world"), stamp.Crc32CUpdate(stamp.Crc32C("hello "), "world"))
	// The byte-slice forms read the same bytes in place and must agree with the string forms,
	// including the update chains and an empty and a one-byte slice.
	mut bytes = []u8{}
	for i in 0..300 {
		bytes = append(bytes, u8(i*7))
	}
	let mid = 128
	let byteOk = stamp.Crc32Bytes(bytes) == stamp.Crc32(str(bytes)) && stamp.Crc32CBytes(bytes) == stamp.Crc32C(str(bytes)) && stamp.Crc32Bytes([]u8{}) == stamp.Crc32("") && stamp.Crc32CUpdateBytes(0, []u8{}) == 0 && stamp.Crc32Bytes([]u8{7}) == stamp.Crc32(str(u8(7))) && stamp.Crc32UpdateBytes(stamp.Crc32Bytes(bytes[:mid]), bytes[mid:]) == stamp.Crc32Update(stamp.Crc32(str(bytes[:mid])), str(bytes[mid:])) && stamp.Crc32CUpdateBytes(stamp.Crc32CBytes(bytes[:mid]), bytes[mid:]) == stamp.Crc32CUpdate(stamp.Crc32C(str(bytes[:mid])), str(bytes[mid:]))
	say.Out("bytes %08x %08x match=%v\n", stamp.Crc32Bytes(bytes), stamp.Crc32CBytes(bytes), byteOk)
	mut big = []u8{}
	for i in 0..100000 {
		big = append(big, u8(i*7))
	}
	let b = str(big)
	say.Out("big crc32=%08x crc32c=%08x adler=%08x xxh64=%016x\n", stamp.Crc32(b), stamp.Crc32C(b), stamp.Adler32(b), stamp.Xxh64(b, 0))
}
