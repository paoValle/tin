package main

// Adam7-interlaced PNGs decode as Go 1.27's image/png decodes them. Tin refused every interlaced PNG before. The six images
// cover 1-bit and 8-bit gray, 16-bit RGB, 4-bit palette, gray with alpha and 8-bit RGBA, a 1x1 image whose six later passes
// are empty, and every row filter in every pass. Each line is Go's bounds and the hash of every pixel.

import "image"
import "image/png"
import "say"
import "seal"

fn sum(img dyn image.Image) str {
	let b = img.Bounds()
	mut h = u64(1469598103934665603)
	for y in b.Min.Y..b.Max.Y {
		for x in b.Min.X..b.Max.X {
			let c = img.At(x, y)
			for v in []u64{u64(c.R), u64(c.G), u64(c.B), u64(c.A)} {
				h = h ^ v
				h = h *% 1099511628211
			}
		}
	}
	return say.Fmt("(%d,%d)-(%d,%d) %x", b.Min.X, b.Min.Y, b.Max.X, b.Max.Y, h)
}

fn main() {
	let pngs = []str{
		"89504e470d0a1a0a0000000d49484452000000090000000a010000000139797985000000364944415478da63b064e461ec61fac854c4eccef2964187e5068300033fa33e9303b303cb34c6d442266e7ee6302f96c35719d6f50100d0e10a5a3163831a0000000049454e44ae426082",
		"",
		"",
		"89504e470d0a1a0a0000000d49484452000000010000000108060000016812f41f0000000d4944415478da63f8967b560e0006dc024f9931a64e0000000049454e44ae426082",
		"89504e470d0a1a0a0000000d49484452000000030000000908040000012abd6ec4000000524944415478da014700b8ff0054c20101c70287e80392d8046777006197046f1db083001d19f450001d29015f2302c35503bd0104b0d70129d678afc71b0251b129be314a0364e24fb6e53b04cc623fc8e05865da1a52883804780000000049454e44ae426082",
		"89504e470d0a1a0a0000000d49484452000000080000000808000000019663d1c10000005a4944415478da014f00b0ff00bd01910250e0039ab704ff31044443b4fb004f8b906b00af6887fa01809a15a9020dfcd2d203fc5a0f6401da2a35ed26c6ab8e02023ddc776e02fa200311d491278a48bbfb04548da64f83ad35c913fd219f7a39a0c70000000049454e44ae426082",
	}
	for h in pngs {
		let d = seal.HexDecode(h) catch _ {
			say.Line("bad hex")
			continue
		}
		let img = png.Decode(str(d)) catch err {
			say.Line("fault", err)
			continue
		}
		say.Line(sum(img))
	}
}
