package main

// A value struct's inline array of str, slices or value structs holding a str starts with each
// element's zero. A long array is filled by a loop rather than one store per element, which made
// the binary megabytes larger for [100000]str. (A value struct much larger than this one
// fails to link on arm64, #1277.)

import "say"

type P value struct {
	name str
	n    i64
}

type V value struct {
	a [4000]str
	b [40][]i64
	c [20]P
	d [3]str
	n i64
}

fn main() {
	mut v = V{n: 2}
	v.a[3] = "a"
	v.b[39] = append(v.b[39], 5)
	v.c[19].name = "z"
	say.Line(len(v.a), v.a[3], len(v.a[4]), len(v.a[3999]), v.n)
	say.Line(len(v.b[0]), v.b[39], len(v.c[0].name), v.c[19].name, v.c[18].n, len(v.d[2]))
	mut total = 0
	for s in v.a {
		total += len(s)
	}
	say.Line(total)
}
