package main

// Damaged GIF and JPEG streams that Go 1.27's image/gif and image/jpeg decode, and two they refuse. Each line is what Go
// gives: the bounds (and for a GIF the hash of every pixel, which Go's matches), or "fault".
//
// gif: Decode stops after the first frame (a bad block or a missing trailer after it is not read), and a frame's LZW data
// may end without its end code once it has every pixel. jpeg: bytes before a marker are skipped, an AC run past the end of
// a block ends it, a DC category up to 16 is read, a baseline scan's spectral selection is ignored, and the image ends at
// EOI, never at the end of the data. The last line is a damaged PNG chunk's fault, whose name is quoted.

import "image"
import "image/gif"
import "image/jpeg"
import "image/png"
import "say"
import "seal"

fn unhex(s str) str {
	let b = seal.HexDecode(s) catch _ {
		return ""
	}
	return str(b)
}

fn sum(img dyn image.Image) str {
	let b = img.Bounds()
	mut h = u64(1469598103934665603)
	for y in b.Min.Y..b.Max.Y {
		for x in b.Min.X..b.Max.X {
			let c = img.At(x, y)
			for v in []u64{u64(c.R), u64(c.G), u64(c.B), u64(c.A)} {
				h = h ^ v
				h = h *% 1099511628211
			}
		}
	}
	return say.Fmt("%x", h)
}

fn bounds(img dyn image.Image) str {
	let b = img.Bounds()
	return say.Fmt("(%d,%d)-(%d,%d)", b.Min.X, b.Min.Y, b.Max.X, b.Max.Y)
}

fn gifLine(d str) str {
	let img = gif.Decode(d) catch _ {
		return "fault"
	}
	return bounds(img) + " " + sum(img)
}

fn jpegLine(d str) str {
	let img = jpeg.Decode(d) catch _ {
		return "fault"
	}
	return bounds(img)
}

fn main() {
	// A bad block after the first frame, a frame and no trailer, and a frame whose LZW data has no end code.
	say.Line("gif", gifLine(unhex("47494638396105000a008000000000000000002c0000000005000a00000206848fa9cb9d050033")))
	say.Line("gif", gifLine(unhex("474946383961080005008100000000000000440000880000cc2c000000000800050000020e841e7133c9c28c32910d04c13b0500")))
	say.Line("gif", gifLine(unhex("4749463839610e0001008400000000000000440000880000cc0044000044440044880044cc0088000088440088880088cc00cc0000cc4400cc8800cccc00dddd1111110000550000990000dd005500005555004c990049dd00990000994c0099990093dd00dd0000dd4900dd932c000000000e00010000050c60f144cab629cf1641500302003b")))
	// An AC run past the end of a block, a DC category over 11, and a baseline scan whose header says Ss=0, Se=47.
	let ac = unhex("")
	say.Line("jpeg", jpegLine(ac))
	say.Line("jpeg", jpegLine(unhex("")))
	say.Line("jpeg", jpegLine(unhex("")))
	// Junk before the first segment, "\xff\x00" and fill bytes before it, no EOI, and an SOI where the EOI was.
	say.Line("jpeg", jpegLine(ac[:2] + "junk" + ac[2:]))
	say.Line("jpeg", jpegLine(ac[:2] + "\xff\x00\xff\xff" + ac[2:]))
	say.Line("jpeg", jpegLine(ac[:len(ac)-2]))
	say.Line("jpeg", jpegLine(ac[:len(ac)-1] + "\xd8"))
	// A PNG whose IHDR checksum fails after its name was damaged to "IH\nR".
	let p = png.Encode(image.NewGray(image.Rect(0, 0, 1, 1)))
	png.Decode(p[:14] + "\n" + p[15:]) catch err {
		say.Line("png", err)
	}
}
