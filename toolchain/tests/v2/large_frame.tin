package main

// A stack frame past the reaches this codegen asks about (#570). Dyn locals are the first
// frame slots assign_homes hands out, so with 2050 of them the last sit past the 32760
// bytes a scaled imm12 of ldr/str reaches, and both words of one need the address built
// in a scratch register; the 100 plain locals spilled behind them, the callee-saved
// registers the prologue saves and restores, and the closure's parameters (five dyn and
// twelve int, most of them on the stack) need it too. Generated once by a script; the
// expected output follows from the literals.

import "say"

shape Spoke {
	speak() i64
}

type Dog struct {
	x i64
}

fn (d Dog) speak() i64 {
	return d.x + 2
}

