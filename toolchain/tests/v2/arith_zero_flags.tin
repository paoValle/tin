package main

import "say"

fn sub_lt_zero(a i64, b i64) i64 {
	if a - b < 0 {
		return 1
	}
	return 0
}

fn add_eq_zero(a i64, b i64) i64 {
	if a + b == 0 {
		return 1
	}
	return 0
}

fn main() {
	if sub_lt_zero(3, 7) != 1 || sub_lt_zero(7, 3) != 0 || add_eq_zero(-3, 3) != 1 || add_eq_zero(2, 3) != 0 {
		panic("arithmetic comparison result")
	}
	say.Line("ok")
}
