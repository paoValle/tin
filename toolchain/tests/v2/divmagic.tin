package main

import "say"

fn signedDiv(a i64, b i64) i64 { return a / b }
fn signedRem(a i64, b i64) i64 { return a % b }
fn unsignedDiv(a u64, b u64) u64 { return a / b }
fn unsignedRem(a u64, b u64) u64 { return a % b }

fn s3q(a i64) i64 { return a / 3 }
fn s3r(a i64) i64 { return a % 3 }
fn s7q(a i64) i64 { return a / 7 }
fn s7r(a i64) i64 { return a % 7 }
fn s10q(a i64) i64 { return a / 10 }
fn s10r(a i64) i64 { return a % 10 }
fn s13q(a i64) i64 { return a / 13 }
fn s13r(a i64) i64 { return a % 13 }
fn sn3q(a i64) i64 { return a / -3 }
fn sn3r(a i64) i64 { return a % -3 }
fn sn10q(a i64) i64 { return a / -10 }
fn sn10r(a i64) i64 { return a % -10 }
fn u3q(a u64) u64 { return a / 3 }
fn u3r(a u64) u64 { return a % 3 }
fn u7q(a u64) u64 { return a / 7 }
fn u7r(a u64) u64 { return a % 7 }
fn u10q(a u64) u64 { return a / 10 }
fn u10r(a u64) u64 { return a % 10 }
fn u13q(a u64) u64 { return a / 13 }
fn u13r(a u64) u64 { return a % 13 }
fn u100q(a u64) u64 { return a / 100 }
fn u100r(a u64) u64 { return a % 100 }

fn main() {
	mut bad = 0
	let signed = []i64{-9223372036854775807 - 1, -9223372036854775807, -1001, -101, -17, -13, -11, -10, -9, -7, -5, -3, -1, 0, 1, 3, 5, 7, 9, 10, 11, 13, 17, 101, 1001, 9223372036854775807}
	for x in signed {
		if s3q(x) != signedDiv(x, 3) || s3r(x) != signedRem(x, 3) || s7q(x) != signedDiv(x, 7) || s7r(x) != signedRem(x, 7) || s10q(x) != signedDiv(x, 10) || s10r(x) != signedRem(x, 10) || s13q(x) != signedDiv(x, 13) || s13r(x) != signedRem(x, 13) || sn3q(x) != signedDiv(x, -3) || sn3r(x) != signedRem(x, -3) || sn10q(x) != signedDiv(x, -10) || sn10r(x) != signedRem(x, -10) {
			bad = bad + 1
		}
	}
	let unsigned = []u64{0, 1, 2, 3, 7, 10, 13, 99, 100, 101, 0x7fffffffffffffff, 0x8000000000000000, 0xffffffffffffffff}
	for x in unsigned {
		if u3q(x) != unsignedDiv(x, 3) || u3r(x) != unsignedRem(x, 3) || u7q(x) != unsignedDiv(x, 7) || u7r(x) != unsignedRem(x, 7) || u10q(x) != unsignedDiv(x, 10) || u10r(x) != unsignedRem(x, 10) || u13q(x) != unsignedDiv(x, 13) || u13r(x) != unsignedRem(x, 13) || u100q(x) != unsignedDiv(x, 100) || u100r(x) != unsignedRem(x, 100) {
			bad = bad + 1
		}
	}
	if bad == 0 {
		say.Line("divmagic: ok")
	} else {
		say.Line("divmagic mismatches", bad)
	}
}
